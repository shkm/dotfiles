#!/usr/bin/env bash
#
# Switch the theme shown for the current OS appearance, or list available.
#
# Two symlinks decide what shows: active-dark (when the OS is in dark mode)
# and active-light (when it's light). Any theme can go in either slot — a
# theme's MODE in env.sh is just a label, not a constraint.
#
# Usage:
#   theme-switch                     show actives + list available
#   theme-switch <name>              set the current-appearance theme
#   theme-switch -i                  pick any theme (fzf) for the current appearance
#   theme-switch -d|--dark [name]    set the dark-appearance slot
#   theme-switch -l|--light [name]   set the light-appearance slot
#
# -d/-l take an optional <name>; without one they open the fzf picker.

set -euo pipefail

themes_dir="$HOME/.config/themes"
ghostty_conf="$themes_dir/.ghostty.conf"

# Echo the value of $VAR from a theme's env.sh, or empty if unset/missing.
theme_var() {
  local name=$1 var=$2
  local env_file="$themes_dir/$name/env.sh"
  [ -f "$env_file" ] || { echo ""; return; }
  (
    # shellcheck source=/dev/null
    . "$env_file"
    eval "printf '%s' \"\${$var:-}\""
  )
}

active_for() {
  local mode=$1
  local link="$themes_dir/active-$mode"
  [ -L "$link" ] && basename "$(readlink "$link")"
}

# Echo "dark" or "light" for the current OS appearance (mirrors theme-env).
current_mode() {
  case "$(uname)" in
    Darwin)
      [ "$(dark-mode status)" = "on" ] && echo dark || echo light ;;
    *)
      case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in
        *dark*) echo dark ;;
        *)      echo light ;;
      esac ;;
  esac
}

list_themes() {
  local dark_active light_active
  dark_active=$(active_for dark)
  light_active=$(active_for light)

  printf "Active:\n"
  printf "  dark:  %s\n" "${dark_active:-<none>}"
  printf "  light: %s\n" "${light_active:-<none>}"

  printf "\nAvailable:\n"
  for mode in dark light; do
    printf "  [%s]\n" "$mode"
    for d in "$themes_dir"/*/; do
      local name
      name=$(basename "$d")
      [[ "$name" == active-* ]] && continue
      local m
      m=$(theme_var "$name" MODE)
      [ "$m" = "$mode" ] || continue
      local marker=" "
      if { [ "$mode" = dark ] && [ "$name" = "$dark_active" ]; } \
         || { [ "$mode" = light ] && [ "$name" = "$light_active" ]; }; then
        marker="*"
      fi
      printf "    %s %s\n" "$marker" "$name"
    done
  done
}

# Emit "name (mode)" for each theme (skips the active-* symlinks).
enumerate_themes() {
  for d in "$themes_dir"/*/; do
    local name
    name=$(basename "$d")
    [[ "$name" == active-* ]] && continue
    printf '%s (%s)\n' "$name" "$(theme_var "$name" MODE)"
  done
}

# fzf picker over all themes; echoes the selected theme name.
pick_theme() {
  enumerate_themes | sort -k2 | fzf \
    --prompt='theme> ' --height='60%' --reverse \
    --preview "cat '$themes_dir'/{1}/env.sh" \
    --preview-window='right,50%' \
    | awk '{print $1}'
}

write_ghostty_conf() {
  local dark light dark_g light_g
  dark=$(active_for dark)
  light=$(active_for light)
  dark_g=$(theme_var "$dark" GHOSTTY_THEME)
  light_g=$(theme_var "$light" GHOSTTY_THEME)
  printf "theme = dark:%s,light:%s\n" "$dark_g" "$light_g" > "$ghostty_conf"
}

# Tell running Ghostty instances to re-read their config (SIGUSR2). On macOS the
# process comm is the full .app path, so pgrep -x/-f don't match it — fall back
# to matching comm ending in /ghostty. Matching comm (not args) avoids false
# hits on processes that merely have Ghostty.app in $PATH.
reload_ghostty() {
  local pids
  pids=$(pgrep -x ghostty 2>/dev/null || true)
  [ -n "$pids" ] || pids=$(ps -Ao pid=,comm= | awk '$2 ~ /(^|\/)ghostty$/ {print $1}')
  [ -n "$pids" ] || return 0
  # shellcheck disable=SC2086
  kill -USR2 $pids 2>/dev/null || true
}

if [ "$#" -eq 0 ]; then
  list_themes
  exit 0
fi

# slot is the appearance we're setting; defaults to the current OS appearance.
# An empty name falls through to the fzf picker.
name=""
slot=""
case "$1" in
  -i|--interactive) ;;
  -d|--dark)        slot=dark;  name=${2:-} ;;
  -l|--light)       slot=light; name=${2:-} ;;
  -*)               echo "theme-switch: unknown option: $1" >&2; exit 1 ;;
  *)                name=$1 ;;
esac
[ -n "$slot" ] || slot=$(current_mode)

if [ -z "$name" ]; then
  command -v fzf >/dev/null || { echo "theme-switch: fzf not installed" >&2; exit 1; }
  name=$(pick_theme) || true
  [ -n "$name" ] || exit 0
fi

if [ ! -d "$themes_dir/$name" ]; then
  echo "no such theme: $name" >&2
  echo >&2
  list_themes >&2
  exit 1
fi

if [ "$(active_for "$slot")" = "$name" ]; then
  echo "already on $name ($slot)."
  exit 0
fi

ln -sfn "$name" "$themes_dir/active-$slot"
write_ghostty_conf

if command -v bat >/dev/null; then
  bat cache --build >/dev/null
fi

reload_ghostty

echo "switched $slot theme to $name."
