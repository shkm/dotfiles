#!/usr/bin/env bash
#
# Switch the active dark or light theme, or list available ones.
#
# Each theme dir under ~/.config/themes/ ships an env.sh declaring its
# MODE (dark or light). Switching reads that MODE and updates the
# matching active-<mode> symlink — light and dark are independent.
#
# Usage:
#   theme-switch              show actives + list available
#   theme-switch <name>       switch the matching mode to <name>

set -euo pipefail

themes_dir="$HOME/.config/themes"
ghostty_conf="$themes_dir/.ghostty.conf"

# Echo the value of $VAR from a theme's env.sh, or empty if unset/missing.
theme_var() {
  local name=$1 var=$2
  local env_file="$themes_dir/$name/env.sh"
  [ -f "$env_file" ] || { echo ""; return; }
  (
    # shellcheck source=/dev/null
    . "$env_file"
    eval "printf '%s' \"\${$var:-}\""
  )
}

active_for() {
  local mode=$1
  local link="$themes_dir/active-$mode"
  [ -L "$link" ] && basename "$(readlink "$link")"
}

list_themes() {
  local dark_active light_active
  dark_active=$(active_for dark)
  light_active=$(active_for light)

  printf "Active:\n"
  printf "  dark:  %s\n" "${dark_active:-<none>}"
  printf "  light: %s\n" "${light_active:-<none>}"

  printf "\nAvailable:\n"
  for mode in dark light; do
    printf "  [%s]\n" "$mode"
    for d in "$themes_dir"/*/; do
      local name
      name=$(basename "$d")
      [[ "$name" == active-* ]] && continue
      local m
      m=$(theme_var "$name" MODE)
      [ "$m" = "$mode" ] || continue
      local marker=" "
      if { [ "$mode" = dark ] && [ "$name" = "$dark_active" ]; } \
         || { [ "$mode" = light ] && [ "$name" = "$light_active" ]; }; then
        marker="*"
      fi
      printf "    %s %s\n" "$marker" "$name"
    done
  done
}

write_ghostty_conf() {
  local dark light dark_g light_g
  dark=$(active_for dark)
  light=$(active_for light)
  dark_g=$(theme_var "$dark" GHOSTTY_THEME)
  light_g=$(theme_var "$light" GHOSTTY_THEME)
  printf "theme = dark:%s,light:%s\n" "$dark_g" "$light_g" > "$ghostty_conf"
}

if [ "$#" -eq 0 ]; then
  list_themes
  exit 0
fi

name=$1

if [ ! -d "$themes_dir/$name" ]; then
  echo "no such theme: $name" >&2
  echo >&2
  list_themes >&2
  exit 1
fi

mode=$(theme_var "$name" MODE)
case "$mode" in
  dark|light) ;;
  *)
    echo "theme '$name' has no MODE=dark|light in env.sh" >&2
    exit 1
    ;;
esac

if [ "$(active_for "$mode")" = "$name" ]; then
  echo "already on $name ($mode)."
  exit 0
fi

ln -sfn "$name" "$themes_dir/active-$mode"
write_ghostty_conf

if command -v bat >/dev/null; then
  bat cache --build >/dev/null
fi

if pgrep -x ghostty >/dev/null; then
  pkill -USR2 -x ghostty || true
fi

echo "switched $mode theme to $name."
