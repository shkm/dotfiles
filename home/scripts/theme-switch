#!/usr/bin/env bash
#
# Switch the active theme, or list available ones.
#
# Usage:
#   theme-switch              show active + list
#   theme-switch <name>       switch to <name>

set -euo pipefail

themes_dir="$HOME/.config/themes"
active_link="$themes_dir/active"

list_themes() {
  local active=""
  [ -L "$active_link" ] && active=$(readlink "$active_link")

  echo "Available themes:"
  for d in "$themes_dir"/*/; do
    local name
    name=$(basename "$d")
    [ "$name" = "active" ] && continue
    if [ "$name" = "$active" ]; then
      printf "  * %s (active)\n" "$name"
    else
      printf "    %s\n" "$name"
    fi
  done
}

if [ "$#" -eq 0 ]; then
  list_themes
  exit 0
fi

name=$1

if [ ! -d "$themes_dir/$name" ]; then
  echo "no such theme: $name" >&2
  echo >&2
  list_themes >&2
  exit 1
fi

# No-op if already active.
if [ -L "$active_link" ] && [ "$(readlink "$active_link")" = "$name" ]; then
  echo "already on $name."
  exit 0
fi

ln -sfn "$name" "$active_link"

if command -v bat >/dev/null; then
  bat cache --build >/dev/null
fi

# Ghostty reads its config once at startup and reloads on SIGUSR2
# (since v1.2.0). Tell every running ghostty to repaint.
if pgrep -x ghostty >/dev/null; then
  pkill -USR2 -x ghostty || true
fi

echo "switched to $name."
