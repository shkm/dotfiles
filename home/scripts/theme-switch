#!/usr/bin/env bash
#
# Switch the active theme by repointing ~/.config/themes/active.
# Rebuilds bat's cache and signals ghostty to reload its config so
# running windows pick up the new palette without restart.
#
# Usage: theme-switch <name>
#   <name> must match a directory under ~/.config/themes/.

set -euo pipefail

name=${1:?usage: theme-switch <name>}
themes_dir="$HOME/.config/themes"

if [ ! -d "$themes_dir/$name" ]; then
  echo "no such theme: $name (looked under $themes_dir)" >&2
  ls -1 "$themes_dir" 2>/dev/null | grep -v '^active$' >&2
  exit 1
fi

ln -sfn "$name" "$themes_dir/active"

if command -v bat >/dev/null; then
  bat cache --build >/dev/null
fi

# Ghostty reads its config once at startup and reloads on SIGUSR2
# (since v1.2.0). Tell every running ghostty to repaint.
if pgrep -x ghostty >/dev/null; then
  pkill -USR2 -x ghostty || true
fi

echo "switched to $name."
