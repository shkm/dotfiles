#!/usr/bin/env bash
#
# Detect OS appearance and output theme variables.
# Exits 0 for dark, 1 for light.
#
# Usage:
#   eval "$(theme-env)"       # POSIX sh
#   eval (theme-env)          # fish (via fenv in .profile)

dark=1

case "$(uname)" in
  Darwin)
    [[ "$(dark-mode status)" == "on" ]] || dark=0
    ;;
  *)
    scheme=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)
    [[ "$scheme" == *dark* ]] || dark=0
    ;;
esac

themes_dir="$HOME/.config/themes"

# Fall back to defaults when active-dark/active-light aren't valid symlinks
# (e.g. a clone with core.symlinks=false checks them out as plain files).
resolve_theme() {
  local link="$themes_dir/$1" fallback="$2" target
  target=$(readlink "$link") && [ -n "$target" ] || target="$fallback"
  basename "$target"
}

dark_theme=$(resolve_theme active-dark tokyonight-storm)
light_theme=$(resolve_theme active-light tokyonight-day)

if [ "$dark" -eq 1 ]; then
  current="$dark_theme"
else
  current="$light_theme"
fi

if [ ! -f "$themes_dir/$current/env.sh" ]; then
  echo "theme-env: missing $themes_dir/$current/env.sh" >&2
  exit $(( 1 - dark ))
fi

# shellcheck source=/dev/null
. "$themes_dir/$current/env.sh"

echo "export DARK_MODE=$dark"
echo "export DARK_MODE_THEME=$dark_theme"
echo "export LIGHT_MODE_THEME=$light_theme"
echo "export THEME=$THEME"
echo "export BAT_THEME=\"$BAT_THEME\""
echo "export FISH_THEME=\"$FISH_THEME\""

exit $(( 1 - dark ))
