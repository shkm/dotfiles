[delta "ayu-light"]
	blame-palette = "#f8f9fa #f3f4f5 #ecedee #e1e2e3 #d3d4d5"
	commit-decoration-style = "box ul"
	dark = false
	file-decoration-style = "#5c6166"
	file-style = "#5c6166"
	hunk-header-decoration-style = "box ul"
	hunk-header-file-style = "bold"
	hunk-header-line-number-style = "bold #787b80"
	hunk-header-style = "file line-number syntax"
	line-numbers = true
	line-numbers-left-style = "#abb0b6"
	line-numbers-minus-style = "bold #f07171"
	line-numbers-plus-style = "bold #86b300"
	line-numbers-right-style = "#abb0b6"
	line-numbers-zero-style = "#abb0b6"
	# 25% red 75% base
	minus-emph-style = "bold syntax #f7c9c9"
	# 10% red 90% base
	minus-style = "syntax #fbe4e4"
	# 25% green 75% base
	plus-emph-style = "bold syntax #dde7c0"
	# 10% green 90% base
	plus-style = "syntax #eef2e0"
	map-styles = \
		bold purple => syntax "#ece2f7", \
		bold blue => syntax "#dceaf8", \
		bold cyan => syntax "#dcf1ea", \
		bold yellow => syntax "#fcefd6"
	# Should match the name of the bat theme
	syntax-theme = "Ayu Light"
