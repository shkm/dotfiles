[delta "catppuccin-latte"]
	dark = false
	syntax-theme = "Catppuccin Latte"
	line-numbers = true
	line-numbers-left-style = "#acb0be"
	line-numbers-right-style = "#acb0be"
	line-numbers-zero-style = "#bcc0cc"
	line-numbers-minus-style = "#d20f39"
	line-numbers-plus-style = "#40a02b"
	minus-style = syntax "#f0c9cf"
	minus-non-emph-style = syntax "#f0c9cf"
	minus-emph-style = syntax "#e39aa5"
	minus-empty-line-marker-style = syntax "#f0c9cf"
	plus-style = syntax "#c9dfc9"
	plus-non-emph-style = syntax "#c9dfc9"
	plus-emph-style = syntax "#a5d0a5"
	plus-empty-line-marker-style = syntax "#c9dfc9"
	file-decoration-style = "#4c4f69"
	file-style = "#4c4f69"
	hunk-header-decoration-style = "box ul"
	hunk-header-file-style = "bold"
	hunk-header-line-number-style = "bold #5c5f77"
	hunk-header-style = "file line-number syntax"
	commit-decoration-style = "box ul"
	blame-palette = "#eff1f5 #e6e9ef #ccd0da #bcc0cc #acb0be"
