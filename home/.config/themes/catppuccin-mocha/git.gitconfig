[delta "catppuccin-mocha"]
	dark = true
	syntax-theme = "Catppuccin Mocha"
	line-numbers = true
	line-numbers-left-style = "#585b70"
	line-numbers-right-style = "#585b70"
	line-numbers-zero-style = "#45475a"
	line-numbers-minus-style = "#f38ba8"
	line-numbers-plus-style = "#a6e3a1"
	minus-style = syntax "#443039"
	minus-non-emph-style = syntax "#443039"
	minus-emph-style = syntax "#5e3a44"
	minus-empty-line-marker-style = syntax "#443039"
	plus-style = syntax "#2c3d34"
	plus-non-emph-style = syntax "#2c3d34"
	plus-emph-style = syntax "#3a5544"
	plus-empty-line-marker-style = syntax "#2c3d34"
	file-decoration-style = "#cdd6f4"
	file-style = "#cdd6f4"
	hunk-header-decoration-style = "box ul"
	hunk-header-file-style = "bold"
	hunk-header-line-number-style = "bold #bac2de"
	hunk-header-style = "file line-number syntax"
	commit-decoration-style = "box ul"
	blame-palette = "#1e1e2e #181825 #313244 #45475a #585b70"
