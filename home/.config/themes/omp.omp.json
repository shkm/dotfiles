{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "blue": "#4385be",
    "closer": "p:os",
    "lavender": "#8b7ec8",
    "os": "#878580",
    "pink": "#da702c"
  },
  "palettes": {
    "template": "{{ .Env.THEME }}",
    "list": {
      "tokyonight-storm": {
        "blue": "#7aa2f7",
        "closer": "p:os",
        "lavender": "#bb9af7",
        "os": "#9aa5ce",
        "pink": "#ff9e64"
      },
      "tokyonight-day": {
        "blue": "#2e7de9",
        "closer": "p:os",
        "lavender": "#9854f1",
        "os": "#8990b3",
        "pink": "#b15c00"
      },
      "ayu-dark": {
        "blue": "#59C2FF",
        "closer": "p:os",
        "lavender": "#D2A6FF",
        "os": "#8A9199",
        "pink": "#E6B450"
      },
      "ayu-light": {
        "blue": "#399EE6",
        "closer": "p:os",
        "lavender": "#A37ACC",
        "os": "#ABB0B6",
        "pink": "#FFAA33"
      },
      "catppuccin-mocha": {
        "blue": "#89b4fa",
        "closer": "p:os",
        "lavender": "#b4befe",
        "os": "#bac2de",
        "pink": "#fab387"
      },
      "catppuccin-latte": {
        "blue": "#1e66f5",
        "closer": "p:os",
        "lavender": "#7287fd",
        "os": "#5c5f77",
        "pink": "#fe640b"
      },
      "flexoki-dark": {
        "blue": "#4385be",
        "closer": "p:os",
        "lavender": "#8b7ec8",
        "os": "#878580",
        "pink": "#da702c"
      },
      "flexoki-light": {
        "blue": "#205ea6",
        "closer": "p:os",
        "lavender": "#5e409d",
        "os": "#6f6e69",
        "pink": "#bc5215"
      }
    }
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "folder_icon": "",
            "home_icon": "",
            "max_depth": 1,
            "style": "agnoster_short",
            "mapped_locations_enabled": true,
            "mapped_locations": {
              "~/repos": ""
            }
          },
          "template": "{{ .Path }} ",
          "foreground": "p:pink",
          "type": "path",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_status": false,
            "fetch_ahead_counter": false,
            "ignore_working_copy": true
          },
          "template": " {{ if .ClosestBookmarks }}{{ .ClosestBookmarks }}{{ else }}{{ .ChangeID }}{{ end }} ",
          "foreground": "p:lavender",
          "type": "jujutsu",
          "style": "plain"
        },
        {
          "properties": {
            "branch_icon":" ",
            "cache_duration": "none",
            "cherry_pick_icon": " ",
            "commit_icon": " ",
            "disable_with_jj": true,
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": " ",
            "no_commits_icon": " ",
            "rebase_icon": " ",
            "revert_icon": " ",
            "tag_icon": " "
          },
          "template": "{{ .HEAD }} ",
          "foreground": "p:lavender",
          "type": "git",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "",
          "foreground": "p:closer",
          "type": "text",
          "style": "plain"
        }
      ]
    }
  ],
  "version": 3,
  "final_space": true
}
