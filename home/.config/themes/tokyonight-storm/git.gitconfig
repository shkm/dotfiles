[delta "tokyonight-storm"]
	dark = true
	syntax-theme = "Tokyo Night Storm"
	line-numbers = true
	line-numbers-left-style = "#414868"
	line-numbers-right-style = "#414868"
	line-numbers-zero-style = "#3b4261"
	line-numbers-minus-style = "#914c54"
	line-numbers-plus-style = "#449dab"
	minus-style = syntax "#52313f"
	minus-non-emph-style = syntax "#52313f"
	minus-emph-style = syntax "#763842"
	minus-empty-line-marker-style = syntax "#52313f"
	plus-style = syntax "#2b485a"
	plus-non-emph-style = syntax "#2b485a"
	plus-emph-style = syntax "#316172"
	plus-empty-line-marker-style = syntax "#2b485a"
	file-decoration-style = "#c0caf5"
	file-style = "#c0caf5"
	hunk-header-decoration-style = "box ul"
	hunk-header-file-style = "bold"
	hunk-header-line-number-style = "bold #a9b1d6"
	hunk-header-style = "file line-number syntax"
	commit-decoration-style = "box ul"
	blame-palette = "#24283b #292e42 #2f344c #353a55 #3b4261"
